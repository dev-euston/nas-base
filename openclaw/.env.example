# Port the OpenClaw gateway listens on.
OPENCLAW_PORT=18789

# Gateway password — change this before deploying.
OPENCLAW_GATEWAY_PASSWORD=

# Read/write workspace exposed to Claude at /home/node/.openclaw/workspace.
# Dev: ./dev-volumes/openclaw-workspace
# NAS: /volume2/openclaw-workspace
WORKSPACE_PATH=./dev-volumes/openclaw-workspace

# Main file library mounted at /nas inside the container.
# Dev: ./dev-volumes/openclaw-media
# NAS: /volume1
FILES_PATH=./dev-volumes/openclaw-media
